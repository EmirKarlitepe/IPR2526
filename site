css




/* Genel Ayarlar ve Tipografi */
:root {
    --primary-color: #007bff; /* Mavi tonu */
    --secondary-color: #6c757d; /* Gri tonu */
    --light-bg: #f8f9fa; /* Açık arka plan */
    --dark-bg: #343a40; /* Koyu arka plan (navigasyon ve footer) */
    --text-color: #343a40; /* Koyu metin rengi */
    --white-color: #ffffff;
    --border-color: #e9ecef; /* Daha açık border */
    --shadow-light: 0 4px 15px rgba(0, 0, 0, 0.08); /* Daha belirgin gölge */
    --section-bg-odd: var(--white-color); /* Tek bölümlerin arka planı */
    --section-bg-even: var(--light-bg); /* Çift bölümlerin arka planı */
}

body {
    font-family: 'Roboto', sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    background-color: var(--light-bg);
    color: var(--text-color);
    scroll-behavior: smooth;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    overflow: hidden;
    padding: 0 15px;
}

h1, h2, h3, h4 {
    color: var(--dark-bg);
    margin-bottom: 1.5rem; /* Başlıklar arası boşluk */
    font-weight: 700;
    text-align: center;
    text-transform: uppercase; /* Başlıkları büyük harf yapar */
}

h1 { font-size: 3.2rem; }
h2 { font-size: 2.5rem; }
h3 { font-size: 1.8rem; }
h4 { font-size: 1.4rem; }

p {
    margin-bottom: 1rem;
    font-weight: 300;
}

.section-description {
    font-size: 1.1rem;
    color: var(--secondary-color);
    max-width: 700px;
    margin: 0 auto 3rem auto; /* Ortalanmış açıklama metni */
    text-align: center;
}

/* Linkler */
a {
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.3s ease;
}

a:hover {
    color: #0056b3;
    text-decoration: none; /* Link hover'da alt çizgi olmasın */
}

/* Düğmeler (Button) */
.btn {
    display: inline-block;
    background-color: var(--primary-color);
    color: var(--white-color);
    padding: 15px 30px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    text-align: center;
    transition: background-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.5px;
    box-shadow: 0 5px 15px rgba(0, 123, 255, 0.2); /* Düğme gölgesi */
}

.btn:hover {
    background-color: #0056b3;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 123, 255, 0.3);
}

.btn-hero { /* Hero section'daki düğme için özel stil */
    background-color: var(--white-color);
    color: var(--primary-color);
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2);
}
.btn-hero:hover {
    background-color: var(--primary-color);
    color: var(--white-color);
    box-shadow: 0 8px 20px rgba(255, 255, 255, 0.3);
}

/* Header ve Navigasyon */
header {
    background-color: var(--dark-bg);
    color: var(--white-color);
    padding: 1rem 0;
    box-shadow: var(--shadow-light);
    position: sticky;
    top: 0;
    z-index: 1000;
}

header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px; /* Navigasyon yüksekliği */
}

.site-logo {
    color: var(--white-color);
    font-size: 1.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    display: flex; /* İkon ve metni hizalamak için */
    align-items: center;
}

.site-logo i {
    margin-right: 10px;
    color: var(--primary-color); /* İkon rengi */
    font-size: 2.2rem;
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
}

nav ul li {
    margin-left: 30px; /* Menü öğeleri arası boşluk */
}

nav ul a {
    color: var(--white-color);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500; /* Daha kalın font */
    padding: 5px 0;
    position: relative;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px; /* Alt çizginin menüden biraz aşağıda olması için */
    width: 0;
    height: 3px; /* Alt çizgi kalınlığı */
    background-color: var(--primary-color);
    transition: width 0.3s ease;
}

nav ul a:hover::after,
nav ul a.active::after { /* Aktif link veya hover durumunda */
    width: 100%;
}

/* Ana Sayfa (Hero Section) */
.hero-section {
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://via.placeholder.com/1920x700/343a40/ffffff?text=Arka+Plan+Gorseli') no-repeat center center/cover;
    color: var(--white-color);
    text-align: center;
    padding: 120px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 600px; /* Daha yüksek hero section */
}

.hero-section h1 {
    font-size: 4rem; /* Daha büyük başlık */
    margin-bottom: 25px;
    color: var(--white-color);
    text-shadow: 2px 2px 6px rgba(0,0,0,0.7);
}

.hero-section p {
    font-size: 1.6rem;
    margin-bottom: 40px;
    font-weight: 300;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
}

/* Bölümler */
main section {
    padding: 100px 0; /* Bölüm iç boşlukları artırıldı */
    margin-bottom: 0;
    border-bottom: 1px solid var(--border-color);
}

main section:last-child {
    border-bottom: none;
}

.about-section, .contact-section {
    background-color: var(--section-bg-odd);
}

.services-section { /* Hizmetler bölümü için farklı arka plan */
    background-color: var(--section-bg-even);
}

/* Değerler Grid */
.values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Biraz daha geniş kartlar */
    gap: 30px;
    margin-top: 50px;
    margin-bottom: 60px;
}

.value-item {
    background: var(--light-bg);
    padding: 35px;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid var(--border-color); /* Kartlara kenarlık */
}

.value-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.12);
}

.value-item h4 {
    color: var(--primary-color);
    margin-bottom: 15px;
    font-size: 1.3rem;
    text-transform: uppercase;
}

.value-item p {
    font-size: 0.95rem;
    color: var(--secondary-color);
    text-align: center;
}

/* Ekip Üyeleri */
.team-members {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    margin-top: 50px;
}

.member {
    background: var(--white-color);
    padding: 30px;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    text-align: center;
    width: 250px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid var(--border-color);
}

.member:hover {
    transform: translateY(-10px);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.12);
}

.member img {
    width: 130px; /* Daha büyük resimler */
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
    border: 5px solid var(--primary-color); /* Kalın border */
    box-shadow: 0 0 0 6px rgba(0, 123, 255, 0.2);
}

.member h4 {
    margin: 15px 0 8px;
    color: var(--dark-bg);
    font-size: 1.4rem;
    text-transform: uppercase;
}

.member p {
    font-size: 1em;
    color: var(--secondary-color);
    text-align: center;
}

/* Hizmetler Bölümü */
.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    margin-top: 50px;
}

.service-item {
    background: var(--white-color);
    padding: 40px;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid var(--border-color);
}

.service-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.12);
}

.service-item i {
    font-size: 3.5rem;
    color: var(--primary-color);
    margin-bottom: 25px;
}

.service-item h3 {
    font-size: 1.6rem;
    color: var(--dark-bg);
    margin-bottom: 15px;
}

.service-item p {
    color: var(--secondary-color);
    font-size: 1rem;
}

/* İletişim Formu ve Bilgileri */
.contact-section {
    background-color: var(--section-bg-odd);
}

.contact-info-form-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /* İki sütunlu düzen */
    gap: 50px; /* İki sütun arası boşluk */
    margin-top: 50px;
}

.contact-info {
    background: var(--white-color);
    padding: 40px;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    border: 1px solid var(--border-color);
}

.contact-info h3 {
    text-align: left; /* Bilgi başlığı sola hizalı */
    margin-bottom: 30px;
    color: var(--dark-bg);
    font-size: 1.6rem;
}

.contact-info p {
    display: flex; /* İkon ve metni hizalamak için */
    align-items: center;
    margin-bottom: 15px;
    font-size: 1.05rem;
    color: var(--secondary-color);
}

.contact-info p i {
    margin-right: 15px;
    color: var(--primary-color);
    font-size: 1.2rem;
}

.social-links {
    margin-top: 30px;
    text-align: left; /* Sosyal medya ikonları sola hizalı */
}

.social-links a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 45px;
    height: 45px;
    background-color: var(--primary-color);
    color: var(--white-color);
    border-radius: 50%;
    font-size: 1.3rem;
    margin-right: 10px;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.social-links a:hover {
    background-color: #0056b3;
    transform: translateY(-3px);
    text-decoration: none;
}

.contact-form {
    background: var(--white-color);
    padding: 40px;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    border: 1px solid var(--border-color);
}

.form-group {
    margin-bottom: 20px;
}

.contact-form input[type="text"],
.contact-form input[type="email"],
.contact-form textarea {
    width: 100%;
    padding: 18px; /* Daha büyük input alanları */
    border: 1px solid var(--border-color);
    border-radius: 5px;
    box-sizing: border-box;
    font-size: 1.05rem;
    background-color: var(--light-bg);
    color: var(--text-color);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.contact-form input[type="text"]:focus,
.contact-form input[type="email"]:focus,
.contact-form textarea:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25);
    outline: none;
    background-color: var(--white-color); /* Odaklandığında arka plan beyaz olsun */
}

.contact-form textarea {
    resize: vertical;
    min-height: 180px; /* Daha büyük mesaj alanı */
}

/* Footer */
footer {
    text-align: center;
    padding: 30px;
    background: var(--dark-bg);
    color: var(--secondary-color);
    font-size: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* Duyarlı Tasarım (Responsive Design) */
@media (max-width: 992px) {
    .contact-info-form-wrapper {
        grid-template-columns: 1fr; /* Tablet ve mobilde tek sütun */
    }
    .contact-info h3 {
        text-align: center;
    }
    .contact-info p, .social-links {
        text-align: center;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    h1 { font-size: 2.8rem; }
    h2 { font-size: 2rem; }
    .hero-section h1 { font-size: 3rem; }
    .hero-section p { font-size: 1.3rem; }
    .hero-section { min-height: 450px; padding: 80px 0; }

    header .container {
        flex-direction: column;
        height: auto;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

    nav ul li {
        margin: 8px 0;
    }

    main section {
        padding: 60px 0;
    }

    .team-members, .values-grid, .services-grid {
        gap: 30px;
    }

    .member, .value-item, .service-item {
        width: 100%;
        max-width: 350px;
        margin: 0 auto;
    }
}

@media (max-width: 576px) {
    h1 { font-size: 2.2rem; }
    h2 { font-size: 1.7rem; }
    .hero-section h1 { font-size: 2.5rem; }
    .hero-section p { font-size: 1.1rem; }
    .hero-section { min-height: 350px; padding: 50px 0; }

    .site-logo { font-size: 1.5rem; }
    .site-logo i { font-size: 1.8rem; }

    .btn { padding: 12px 20px; font-size: 0.9rem; }
    
    .contact-form input[type="text"],
    .contact-form input[type="email"],
    .contact-form textarea { padding: 15px; }
}

